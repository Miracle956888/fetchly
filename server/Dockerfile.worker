# Standalone worker for deployments with shared storage, MySQL and Redis.
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg python3 python3-pip ca-certificates openssl \
    && python3 -m pip install --no-cache-dir --break-system-packages 'yt-dlp[default]==2026.11.23' \
    && rm -rf /var/lib/apt/lists/*

FROM base AS build
ENV NODE_ENV=development
COPY package*.json ./
COPY server/package*.json ./server/
COPY client/package*.json ./client/
RUN npm ci --include=dev
COPY server ./server
# Build-time placeholder only; Prisma generation does not connect to MySQL.
RUN DATABASE_URL='mysql://build:build@localhost:3306/fetchly' npm run db:generate -w server \
    && npm run build -w server

FROM base AS runtime
ENV NODE_ENV=production YTDLP_JS_RUNTIME=node
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/server/package.json ./server/package.json
RUN mkdir -p storage/downloads storage/temp \
    && useradd -m appuser \
    && chown -R appuser:appuser /app
USER appuser
CMD ["node", "server/dist/workers/standalone.js"]
