# ── Learnly LMS — environment ─────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# Database driver: "pglite" (embedded Postgres for local dev, no setup)
# or "pg" (hosted PostgreSQL — required for production / multi-instance).
DATABASE_DRIVER=pglite

# PostgreSQL connection string. Only required when DATABASE_DRIVER=pg.
# DATABASE_URL=postgresql://user:password@host:5432/lms

# Directory for the embedded PGlite data files (development only).
PG_DATA_DIR=./data/pglite

# Run pending SQL migrations automatically when the app boots (dev convenience).
# In production, run `npm run db:migrate` explicitly as a deployment step.
AUTO_MIGRATE=true
