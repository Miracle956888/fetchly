# Development only. Copy to .env; never commit real credentials.
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=dev-only-insecure-secret-change-me
ADMIN_EMAIL=admin@fetchly.local
ADMIN_PASSWORD=change-me-strong-password

# Optional: use a supported JS runtime for YouTube's yt-dlp challenges.
# Requires yt-dlp with the matching yt-dlp-ejs package and Node 22+.
# YTDLP_JS_RUNTIME=node

# Leave these unset to use the in-memory beta datastore and queue.
# DATABASE_URL=mysql://user:password@localhost:3306/fetchly
# REDIS_URL=redis://localhost:6379
