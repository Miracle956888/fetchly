# ─────────────────────────────────────────────────────────────────────────────
# Fetchly environment configuration
#
#   cp .env.example .env      then fill in the required values.
#
# This file ships WITHOUT secret values on purpose — never commit a real .env.
# Variables marked (REQUIRED, production) make the server refuse to boot when
# NODE_ENV=production and they are missing or left at an insecure default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Leave UNSET to log to stdout only (correct for containers / 12-factor).
# Set to a writable directory on a long-lived host (VPS, cPanel) to also keep
# persistent server.log + error.log audit files there.
#LOG_DIR=/var/log/fetchly

# ── Origins (REQUIRED for any real deployment) ───────────────────────────────
# Public URL of the frontend. Used for CORS and secure cookies.
CLIENT_URL=http://localhost:5173
# Public URL of this API.
API_URL=http://localhost:3000
# Additional allowed CORS origins, comma separated (e.g. a preview URL while
# the real domain is in review). Do not use '*'.
#CORS_ORIGINS=https://preview.yourdomain.com

# ── Database (REQUIRED, production) ──────────────────────────────────────────
# MySQL 8 connection string. Apply the schema with:  npm run db:migrate:deploy
# Leave UNSET in local development to use the in-memory store (data is lost on
# restart; the boot log says so loudly).
#DATABASE_URL=mysql://user:password@host:3306/fetchly

# ── Queue (REQUIRED, production) ─────────────────────────────────────────────
# Redis for BullMQ. Leave UNSET in local development for the in-process queue.
#REDIS_URL=redis://localhost:6379
# Deliberately run an ephemeral demo (no database / no redis) in production.
# Only set to true if you ACCEPT that all data and queued jobs are discarded
# on every restart. Default: false (the server refuses to boot instead).
ALLOW_EPHEMERAL_STORAGE=false

# ── Secrets (REQUIRED, production) ───────────────────────────────────────────
# Signs the admin JWT. Generate:  openssl rand -hex 32
# The development default is public and is REJECTED in production.
#JWT_SECRET=
# Password of the auto-seeded admin account (min 8 chars).
# The development default is public and is REJECTED in production.
#ADMIN_PASSWORD=
ADMIN_EMAIL=admin@fetchly.local
# JWT lifetime, e.g. 30m, 8h, 7d
JWT_EXPIRES_IN=8h
# Admin session cookie SameSite: strict | lax | none.
#   strict/lax — frontend + API on the SAME site (Nginx/Docker, cPanel proxy).
#   none       — frontend and API on DIFFERENT sites; forces Secure (HTTPS) and
#                is subject to browser third-party-cookie blocking, in which
#                case the client's bearer-token fallback takes over.
COOKIE_SAMESITE=strict

# ── Storage & job limits ─────────────────────────────────────────────────────
DOWNLOAD_DIR=./storage/downloads
TEMP_DIR=./storage/temp
DOWNLOAD_EXPIRATION_MINUTES=30
TEMP_FILE_RETENTION_MINUTES=60
MAX_DOWNLOAD_SIZE_MB=2048
MAX_CONCURRENT_JOBS_PER_IP=3
MIN_FREE_DISK_MB=1024

# ── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ANALYZE_LIMIT_MAX_REQUESTS=20
LOGIN_LIMIT_MAX_REQUESTS=10

# ── Media engines (optional overrides) ───────────────────────────────────────
#FFMPEG_PATH=/usr/bin/ffmpeg
#YTDLP_PATH=/usr/local/bin/yt-dlp

# ── Frontend build-time variables (set these for the CLIENT build) ───────────
# API origin. Leave UNSET when frontend + API share an origin (recommended),
# so requests stay relative and work behind any reverse proxy.
#VITE_API_ORIGIN=https://api.yourdomain.com
# Canonical public site URL. Drives canonical/og/twitter tags, robots.txt and
# sitemap.xml at build time. Leave UNSET for a local build.
#VITE_SITE_URL=https://yourdomain.com
# Public takedown/contact address shown on the DMCA page.
#VITE_CONTACT_EMAIL=dmca@yourdomain.com
